{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WA Message Failed Event",
  "description": "Falha de envio WhatsApp (espelha domain.MessageFailedPayload).",
  "type": "object",
  "properties": {
    "message_id": { "type": "string" },
    "to": { "type": "string" },
    "error": { "type": "string" },
    "failed_at": { "type": "string", "format": "date-time" }
  },
  "required": ["message_id", "to"]
}
