{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WA Message Sent Event",
  "description": "Mensagem WhatsApp enviada (wa-core-api; espelha domain.MessageSentPayload).",
  "type": "object",
  "properties": {
    "message_id": { "type": "string", "description": "wamid da Meta" },
    "to": { "type": "string" },
    "type": { "type": "string", "description": "text|template|interactive|media" },
    "sent_at": { "type": "string", "format": "date-time" }
  },
  "required": ["message_id", "to"]
}
