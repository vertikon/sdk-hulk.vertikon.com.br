{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Journey Session Started Event",
  "description": "Sessão de jornada iniciada (journey-orchestrator; espelha domain.SessionStartedPayload).",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "user_id": { "type": "string" },
    "phone": { "type": "string" },
    "state": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" }
  },
  "required": ["session_id", "user_id"]
}
