{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Journey State Changed Event",
  "description": "Transição de estado da jornada (espelha domain.StateChangedPayload).",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "user_id": { "type": "string" },
    "previous_state": { "type": "string" },
    "new_state": { "type": "string" },
    "changed_at": { "type": "string", "format": "date-time" }
  },
  "required": ["session_id", "user_id", "new_state"]
}
