{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Student Matricula Event",
  "description": "Publicado pelo admissions-core ao concluir a matrícula online (admissão → ENROLLED). Consumido pelo student-crm (timeline).",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string", "description": "Tenant dono do aluno" },
    "user_id": { "type": "string" },
    "course_id": { "type": "string" },
    "enrollment_id": { "type": "string" },
    "name": { "type": "string", "description": "Nome do aluno (exibição na timeline)" }
  },
  "required": ["tenant_id", "user_id", "course_id"]
}
